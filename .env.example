# === Application ===
APP_NAME=FastAPI Project
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
ENVIRONMENT=local

# === Database ===
# Ці змінні використовуються docker-compose для підняття контейнера БД
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fastapi_labs
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL збирається автоматично з полів вище в app/core/config.py —
# сюди хардкодити не треба, тримай лише для довідки/override:
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/fastapi_labs

# === Security & JWT ===
# Згенерувати новий: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
